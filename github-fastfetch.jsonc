{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },

  "display": {
    "separator": ": ",
    "color": {
      "keys": "yellow"
    },
    "key": {
      "width": 18
    }
  },

  "modules": [
    {
      "type": "command",
      "key": " ",
      "text": "python3 scripts/read_metric.py header",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m────────────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "Public Repos",
      "text": "python3 scripts/read_metric.py public_repos"
    },
    {
      "type": "command",
      "key": "Stars Received",
      "text": "python3 scripts/read_metric.py total_stars"
    },
    {
      "type": "command",
      "key": "Forks Received",
      "text": "python3 scripts/read_metric.py total_forks"
    },
    {
      "type": "command",
      "key": "Pull Requests",
      "text": "python3 scripts/read_metric.py pull_requests"
    },
    {
      "type": "command",
      "key": "Issues",
      "text": "python3 scripts/read_metric.py issues"
    },
    {
      "type": "command",
      "key": "Commits",
      "text": "python3 scripts/read_metric.py commits"
    },
    {
      "type": "command",
      "key": "Contribs (1y)",
      "text": "python3 scripts/read_metric.py contributions_365d"
    },
    {
      "type": "command",
      "key": "Followers",
      "text": "python3 scripts/read_metric.py followers"
    },
    {
      "type": "command",
      "key": "Following",
      "text": "python3 scripts/read_metric.py following"
    },
    {
      "type": "command",
      "key": "Top Language",
      "text": "python3 scripts/read_metric.py top_language"
    },
    {
      "type": "command",
      "key": "Member Since",
      "text": "python3 scripts/read_metric.py member_since"
    },
    {
      "type": "command",
      "key": "Profile",
      "text": "python3 scripts/read_metric.py profile"
    },
    {
      "type": "command",
      "key": "Last Sync",
      "text": "python3 scripts/read_metric.py updated_at"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m██\u001b[31m██\u001b[32m██\u001b[33m██\u001b[34m██\u001b[35m██\u001b[36m██\u001b[37m██\u001b[0m"
    }
  ]
}
