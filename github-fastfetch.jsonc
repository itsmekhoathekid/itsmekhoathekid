{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 0,
      "left": 0,
      "right": 3
    }
  },

  "display": {
    "separator": ": ",
    "color": {
      "keys": "yellow"
    },
    "key": {
      "width": 18
    }
  },

  "modules": [
    {
      "type": "command",
      "key": " ",
      "text": "python3 scripts/read_metric.py header",
      "outputColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[90m────────────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "Role",
      "text": "python3 scripts/read_metric.py role"
    },
    {
      "type": "command",
      "key": "Current Quest",
      "text": "python3 scripts/read_metric.py current_quest"
    },
    {
      "type": "command",
      "key": "Status",
      "text": "python3 scripts/read_metric.py status"
    },
    {
      "type": "command",
      "key": "Fuel",
      "text": "python3 scripts/read_metric.py fuel"
    },
    {
      "type": "command",
      "key": "Timezone",
      "text": "python3 scripts/read_metric.py timezone_status"
    },
    "break",
    {
      "type": "command",
      "key": "◆ Public Repos",
      "text": "python3 scripts/read_metric.py public_repos"
    },
    {
      "type": "command",
      "key": "★ Stars",
      "text": "python3 scripts/read_metric.py total_stars"
    },
    {
      "type": "command",
      "key": "⑂ Forks",
      "text": "python3 scripts/read_metric.py total_forks"
    },
    {
      "type": "command",
      "key": "↗ Pull Requests",
      "text": "python3 scripts/read_metric.py pull_requests"
    },
    {
      "type": "command",
      "key": "! Issues",
      "text": "python3 scripts/read_metric.py issues"
    },
    {
      "type": "command",
      "key": "● Commits",
      "text": "python3 scripts/read_metric.py commits"
    },
    {
      "type": "command",
      "key": "⌁ Contribs (1y)",
      "text": "python3 scripts/read_metric.py contributions_365d"
    },
    {
      "type": "command",
      "key": "♟ Followers",
      "text": "python3 scripts/read_metric.py followers"
    },
    {
      "type": "command",
      "key": "λ Main Language",
      "text": "python3 scripts/read_metric.py top_language"
    },
    "break",
    {
      "type": "command",
      "key": "Achievement",
      "text": "python3 scripts/read_metric.py achievement"
    },
    {
      "type": "command",
      "key": "Last Sync",
      "text": "python3 scripts/read_metric.py updated_at"
    }
  ]
}
